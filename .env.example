# ── Namphrae Portal environment ────────────────────────────────────────────
# Copy to .env.local and fill in. EVERYTHING here is optional for local dev:
# with no vars set, the app uses a local JSON file store (data/portal-config.json)
# and an open admin ("dev-open" mode). Configure these for production.

# MongoDB — the single-document config store, plus the calendarJobs collection
# (see ปฏิทินปฏิบัติงาน in the README). Without it, both fall back to local JSON
# files. Fine for dev, but production MUST set this on ANY host — not just
# Vercel (read-only filesystem at runtime, fails loudly with EROFS). Hosts with
# a writable-but-ephemeral disk, e.g. Railway, are the more dangerous case:
# without this, everything *looks* like it works (jobs save, LINE notifies)
# until the next deploy wipes the disk and every patient record with it. The
# calendar's file backend refuses to run in production without this set — see
# assertFileBackendAllowed() in src/lib/jobs-store.ts.
MONGODB_URI=
MONGODB_DB=namphrae_portal

# Clerk — admin authentication. Without both keys, /admin runs in dev-open mode
# (no login required). Set both to protect the admin in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Admin membership: a signed-in user must ALSO have a record in the shared user
# registry — MongoDB db "db_namphrae", collection "users", matched by clerkId
# (the same registry namphrae-map uses). Optional override:
# MONGODB_USERS_DB=db_namphrae

# clerkId ของผู้จัดการ Portal หลัก — เป็นผู้จัดการเสมอ ถอดจากหน้า /admin/users
# ไม่ได้ (กันระบบไร้ผู้จัดการ) ต้องตั้งบน production ก่อน deploy ระบบสิทธิ์
PORTAL_MANAGER_CLERK_ID=

# Cloudinary — image/video uploads for cards and hero media. Without these, the
# upload button is disabled but pasting an image URL still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# base URL ของรูปเหตุสาธารณภัยรุ่นเก่าที่เก็บเป็น "ชื่อไฟล์" ไม่ใช่ URL เต็ม
# (รุ่นใหม่อัปเข้า Cloudinary เป็น URL เต็มอยู่แล้ว ไม่ผ่านค่านี้)
# ไม่ตั้ง = รูปเก่าเสีย รูปใหม่ปกติ — ค่าที่ namphrae-map ใช้อยู่คือ
# https://namphraesmartcity.ai/calendar/NPDRH/images
NEXT_PUBLIC_IMAGE_BASE_URL=

# LINE Messaging API — แจ้งเตือนกลุ่มเจ้าหน้าที่เมื่อมีงานปฏิทินใหม่เข้ามารออนุมัติ
# ถ้าไม่ตั้ง ระบบยังใช้งานได้ปกติทุกอย่าง เพียงแต่ไม่ส่งแจ้งเตือน (ขึ้น warning ใน
# log ฝั่ง server) — หน้า /admin/settings จะบอกสถานะนี้ให้เห็นด้วย
# LINE Notify ปิดบริการแล้ว (31 มี.ค. 2025) จึงต้องใช้ Messaging API เท่านั้น
#
# วิธีตั้ง: สร้าง Messaging API channel ใน LINE Developers Console → คัดลอก
# ค่าสองตัวนี้มา → ตั้ง Webhook URL เป็น https://<โดเมน>/api/line/webhook
# → เชิญบอท OA เข้ากลุ่มเจ้าหน้าที่ (ระบบจะจำ groupId ให้เองตอนบอทเข้ากลุ่ม
# ไม่ต้องกรอกที่ไหนอีก) รายละเอียดครบดูหัวข้อ "ปฏิทินปฏิบัติงาน" ใน README
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# base URL ของเว็บ (ไม่ใส่ / ปิดท้าย) ใช้เติมลิงก์ท้ายข้อความแจ้งเตือน LINE ให้
# เจ้าหน้าที่กดเข้ามาอนุมัติได้เลย ไม่ต้องจำ URL แล้วพิมพ์เองบนมือถือตอนเช้ามืด
# ไม่ตั้งก็ยังส่งแจ้งเตือนได้ปกติ แค่ไม่มีบรรทัดลิงก์ท้ายข้อความ
# เช่น https://namphrae-portal-production.up.railway.app
NEXT_PUBLIC_SITE_URL=

# secret ของ endpoint สรุปตารางงานประจำวัน (POST /api/cron/daily-digest) —
# n8n ยิงมาทุก 17:00 พร้อม header `x-cron-secret` ค่าเดียวกันนี้
# ต้องตั้ง "สองที่ให้ตรงกัน": ที่นี่ (Railway) และใน HTTP Request node ของ n8n
# ไม่ตั้ง = ปิด feature นี้ (endpoint ตอบ 503) ระบบอื่นทำงานปกติ
# วิธี generate: openssl rand -hex 32
CRON_SECRET=
